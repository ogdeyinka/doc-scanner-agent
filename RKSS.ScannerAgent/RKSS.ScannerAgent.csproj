<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>RKSS.ScannerAgent</AssemblyName>
    <RootNamespace>RKSS.ScannerAgent</RootNamespace>
    <Product>RKSS Scanner Agent</Product>
    <Company>RK Systems &amp; Services</Company>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NTwain">
      <HintPath>..\..\ScanAppForWeb-master\packages\NTwain.3.4.1\lib\net40-client\NTwain.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="QuestPDF" Version="2025.7.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
</Project>
